{
  "name": "@echopath-labs/forgerail",
  "version": "0.1.5",
  "description": "Deterministic validation and diagnosis CLI for the ForgeRail Agent Plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forgerail": "scripts/forgerail.mjs"
  },
  "files": [
    ".codex-plugin/",
    "assets/",
    "adapters/",
    "contracts/",
    "docs/",
    "directory/",
    "packs/",
    "scripts/adoption-closeout-regressions.mjs",
    "scripts/adoption-reliability-regressions.mjs",
    "scripts/agw-replacement-regressions.mjs",
    "scripts/build-universal-directory-candidate.mjs",
    "scripts/disposable-consumer.mjs",
    "scripts/forgerail.mjs",
    "scripts/integrity-regressions.mjs",
    "scripts/lib/adoption.mjs",
    "scripts/lib/bounded-read.mjs",
    "scripts/lib/composition.mjs",
    "scripts/lib/contracts.mjs",
    "scripts/lib/diagnosis.mjs",
    "scripts/lib/product-surface.mjs",
    "scripts/local-observation-regressions.mjs",
    "scripts/product-boundary.test.mjs",
    "scripts/reliability-regressions.mjs",
    "scripts/shadow-comparison.mjs",
    "scripts/validate-agw-replacement.mjs",
    "scripts/validate-external-packs.mjs",
    "scripts/validate-open-source-docs.mjs",
    "scripts/validate-release.mjs",
    "scripts/validate-universal-directory.mjs",
    "scripts/validation-scope.test.mjs",
    "scripts/fixtures/",
    "skills/",
    "templates/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "PLUGIN.md",
    "PRIVACY.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "SUPPORT.md",
    "TERMS.md",
    "scripts/lib/project-state.mjs",
    "scripts/lib/project-adoption.mjs",
    "scripts/project-adoption.test.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/forgerail.mjs validate && node scripts/forgerail.mjs validate-fixtures --scope core && node scripts/forgerail.mjs validate-adoption && npm run test:replacement && npm run test:boundary && npm run test:scope && npm run test:adoption && npm run test:reliability && npm run test:project-adoption",
    "test:integrity": "node scripts/integrity-regressions.mjs",
    "test:docs": "node scripts/validate-open-source-docs.mjs",
    "test:consumer": "node scripts/disposable-consumer.mjs",
    "test:release": "node scripts/validate-release.mjs",
    "test:shadow": "node scripts/shadow-comparison.mjs",
    "test:directory": "node scripts/validate-universal-directory.mjs",
    "build:directory-candidate": "node scripts/build-universal-directory-candidate.mjs",
    "diagnose:fixture": "node scripts/forgerail.mjs diagnose --workspace scripts/fixtures/workspaces/markdown-existing",
    "prepublishOnly": "npm run test:maintainer",
    "test:replacement": "node scripts/validate-agw-replacement.mjs && node --test scripts/agw-replacement-regressions.mjs",
    "test:scope": "node --test scripts/validation-scope.test.mjs",
    "test:maintainer": "npm test && npm run test:docs && node scripts/forgerail.mjs validate-fixtures --scope full && npm run test:integrity && npm run test:shadow && npm run test:release && npm run test:consumer && npm run test:directory",
    "test:adoption": "node --test scripts/adoption-closeout-regressions.mjs",
    "test:reliability": "node --test scripts/reliability-regressions.mjs scripts/adoption-reliability-regressions.mjs scripts/local-observation-regressions.mjs",
    "test:boundary": "node --test scripts/product-boundary.test.mjs",
    "test:project-adoption": "node --test scripts/project-adoption.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echopath-labs/forgerail.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
