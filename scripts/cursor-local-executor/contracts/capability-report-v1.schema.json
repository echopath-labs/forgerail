{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echopath-labs.dev/forgerail/cursor-local-executor/capability-report-v1.schema.json",
  "title": "ForgeRail Cursor Local Executor Capability Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "observedAt",
    "status",
    "cli",
    "capabilities",
    "execution",
    "evidence",
    "deviations",
    "promotionRecommendation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapterId": { "const": "cursor-local-executor" },
    "observedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["verified", "degraded", "blocked", "unavailable", "failed"] },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version", "authentication", "helpDigest"],
      "properties": {
        "command": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "authentication": { "enum": ["authenticated", "unauthenticated", "unknown", "unavailable"] },
        "helpDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "method", "limitedReason"],
        "properties": {
          "status": { "enum": ["verified", "supported", "profile-only", "degraded", "blocked", "unavailable", "unknown", "unsupported"] },
          "method": { "type": "string", "minLength": 1 },
          "limitedReason": { "type": ["string", "null"] }
        }
      }
    },
    "execution": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawOutputDigest", "gitBefore", "gitAfter", "changedPaths", "validations"],
      "properties": {
        "rawOutputDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "gitBefore": { "type": ["object", "null"] },
        "gitAfter": { "type": ["object", "null"] },
        "changedPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "validations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "deviations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "promotionRecommendation": { "enum": ["retain-profile-only", "capability-evidence-only", "eligible-for-upstream-review"] }
  }
}
